{
  "name": "@casual/game-solitaire",
  "version": "0.1.0",
  "private": true,
  "description": "솔리테어 하이츠 — 카드를 위·아래로 이어(±1, A↔K 순환) 층층이 타워를 쌓는 트라이픽스형 캐주얼 솔리테어.",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "build": "vite build",
    "preview": "vite preview --port 4209",
    "dev:adsense": "npx vite --mode adsense",
    "build:adsense": "vite build --mode adsense",
    "qa:play": "node scripts/qa-play-regression.mjs",
    "econ:sweep": "node scripts/dashboard-sweep.mjs",
    "gen:unused-assets": "node scripts/gen-unused-assets.mjs",
    "gen:asset-groups": "node scripts/gen-asset-groups.mjs",
    "check:budget": "node scripts/check-texture-budget.mjs",
    "qa:popups": "node scripts/qa-popups.mjs",
    "qa:lots": "node scripts/qa-lots.mjs",
    "qa:bonus": "node scripts/qa-bonus.mjs",
    "qa:league": "node scripts/qa-league.mjs",
    "measure:textures": "node scripts/measure-textures.mjs",
    "gen:diet-hints": "node scripts/gen-diet-hints.mjs",
    "encode:astc": "python scripts/encode-astc.py --deploy d:/tmp/rl-deploy/solitaire --quality medium",
    "verify:astc": "node scripts/verify-astc.mjs",
    "verify:local-build": "node scripts/verify-local-build.mjs",
    "verify:live": "node scripts/verify-live-deploy.mjs"
  },
  "dependencies": {
    "@casual/core": "*",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.21.1"
  }
}
