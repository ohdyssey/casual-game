/** 파싱·검증된 셀 100종(이름 → CellShape). */
export const CELLS: Record<string, CellShape> = (() => {
  const out: Record<string, CellShape> = {};
  const problems: string[] = [];
  for (const [name, art] of Object.entries(ART)) {
    const shape = parseCellArt(name, art);
    problems.push(...validateCellArt(shape));
    out[name] = shape;
  }
  if (problems.length) throw new Error(`셀 라이브러리 격자 규약 위반:\n${problems.join('\n')}`);
  return out;
})();

export const CELL_NAMES: string[] = Object.keys(CELLS);
