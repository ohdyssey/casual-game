/**
 * cell-library.mts — 조립용 **작은 셀 100종** 라이브러리(2026-07-27 3차 재설계).
 *
 * 각 셀은 cell-grid.mts 격자(열=60px·행=82px) 위의 ASCII 아트다 — `#`=카드, `.`=빈칸, 첫 줄이 맨 위 행.
 * 격자 규약상 **같은 행에 인접 열(간격1)을 두면 안 된다**(같은 레이어 겹침) — validateCellArt 가 강제하며,
 * 레이어는 행에서만 유도되므로(cell-grid) "위에 카드가 있으면 아래는 절대 오픈되지 않는다"가 항상 성립한다.
 *
 * 셀은 **작게**(2~14장) 유지한다 — 레벨은 이 셀들을 격자에 여러 개 얹어 만들고(level-assembler.mts),
 * 셀을 1열/1행 어긋나게 겹쳐 놓으면 자동으로 서로 덮어 **셀 간 결합 의존구조**가 생긴다.
 */
import type { GridCell } from './cell-grid.mts';
import { findSameRowOverlaps } from './cell-grid.mts';

export interface CellShape {
  name: string;
  cells: GridCell[];
  cols: number;   // 점유 열 폭(최대열-최소열+1).
  rows: number;   // 점유 행 수.
  count: number;
  symmetric: boolean; // 좌우 거울대칭인가(중앙 배치 가능 여부 판단용).
}

/** ASCII 아트 → 격자 셀 목록. 좌상단이 (0,0) 이 되도록 정규화한다. */
export function parseCellArt(name: string, art: readonly string[]): CellShape {
  const raw: GridCell[] = [];
  art.forEach((line, row) => {
    for (let col = 0; col < line.length; col++) if (line[col] === '#') raw.push({ col, row });
  });
  if (raw.length === 0) throw new Error(`셀 "${name}": 카드가 하나도 없음`);
  const minCol = Math.min(...raw.map((c) => c.col));
  const minRow = Math.min(...raw.map((c) => c.row));
  const cells = raw.map((c) => ({ col: c.col - minCol, row: c.row - minRow }));
  const cols = Math.max(...cells.map((c) => c.col)) + 1;
  const rows = Math.max(...cells.map((c) => c.row)) + 1;
  const key = (c: GridCell) => `${c.col},${c.row}`;
  const set = new Set(cells.map(key));
  const symmetric = cells.every((c) => set.has(key({ col: cols - 1 - c.col, row: c.row })));
  return { name, cells, cols, rows, count: cells.length, symmetric };
}

/** 셀 하나의 격자 규약 위반 목록(빈 배열이면 정상). */
export function validateCellArt(shape: CellShape): string[] {
  return findSameRowOverlaps(shape.cells).map((p) => `[${shape.name}] ${p}`);
}

/** 좌우 반전 셀(거울쌍 배치에 사용). */
export function mirrorShape(shape: CellShape): CellShape {
  const cells = shape.cells.map((c) => ({ col: shape.cols - 1 - c.col, row: c.row }));
  return { ...shape, name: `${shape.name}'`, cells };
}

