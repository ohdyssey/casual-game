{
  // ⚠️ 일부러 `extends` 를 쓰지 않는다(다른 워크스페이스와 다른 점).
  //
  // Vercel 은 Root Directory(services/api)를 기준으로 이 파일을 읽는데, 그 **밖**에 있는
  // ../../tsconfig.base.json 을 따라가지 않는다. 그러면 설정이 통째로 무시되고 기본값
  // (strict 꺼짐)으로 컴파일된다 — 로컬 타입체크는 통과하는데 배포만 깨지는,
  // 원인을 찾기 어려운 실패가 된다(2026-08-11 실제 발생).
  //
  // 그래서 필요한 옵션을 여기 전부 적어 둔다. tsconfig.base.json 을 고칠 때 이 파일도
  // 같이 봐야 한다.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 서버리스 런타임 — DOM 은 없지만 fetch/Request/Response 같은 웹 표준은 쓴다.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    // strict 가 꺼지면 zod 추론이 전부 optional 로 무너지고 판별 유니온 좁히기도 깨진다.
    // 이 서버의 타입 안전성은 여기에 통째로 의존한다.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true
    // 경로 별칭(paths)은 쓰지 않는다 — Vercel 이 지원하지 않고(공식 문서 명시),
    // 별칭을 써도 컴파일된 JS 의 import 문은 그대로 남아 실행 시점에 깨진다.
    // 공유 규칙은 src/rules.ts · src/wire.ts 가 상대경로로 가져온다.
  },
  "include": ["src", "api"]
}
