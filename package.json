{
  "name": "casual-game-platform",
  "version": "0.1.11",
  "private": true,
  "description": "피싱 셸을 수확한 TypeScript 모노레포 — 7종 캐쥬얼게임 양산 플랫폼",
  "type": "module",
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "dev": "concurrently -n hub,store,eco01,bubble,fish,grill,sumo,homerun,dragon -c green,magenta,cyan,yellow,blue,red,redBright,blueBright,cyanBright \"npm:dev:hub\" \"npm:dev:store\" \"npm:dev:eco01\" \"npm:dev:bubblepong\" \"npm:dev:fishing\" \"npm:dev:grillking\" \"npm:dev:sumoclash\" \"npm:dev:homerun\" \"npm:dev:dragonbeat\"",
    "dev:fishing": "npm --prefix ../fishing run dev",
    "dev:hub": "npm run dev --workspace games/hub",
    "build:hub": "npm run build --workspace games/hub",
    "dev:store": "npm run dev --workspace games/store",
    "build:store": "npm run build --workspace games/store",
    "dev:eco01": "npm run dev --workspace games/eco01",
    "build:eco01": "npm run build --workspace games/eco01",
    "dev:bubblepong": "npm run dev --workspace games/bubblepong",
    "build:bubblepong": "npm run build --workspace games/bubblepong",
    "dev:grillking": "npm run dev --workspace games/Grillking",
    "build:grillking": "npm run build --workspace games/Grillking",
    "dev:sumoclash": "npm run dev --workspace games/SumoClash",
    "build:sumoclash": "npm run build --workspace games/SumoClash",
    "dev:homerun": "npm run dev --workspace games/Homerun",
    "build:homerun": "npm run build --workspace games/Homerun",
    "dev:dragonbeat": "npm run dev --workspace games/DragonBeat",
    "build:dragonbeat": "npm run build --workspace games/DragonBeat",
    "build:all": "npm run build:hub && npm run build:store && npm run build:eco01 && npm run build:bubblepong && npm run build:grillking && npm run build:sumoclash && npm run build:homerun && npm run build:dragonbeat",
    "typecheck": "tsc -p packages/core/tsconfig.json && tsc -p games/store/tsconfig.json && tsc -p games/eco01/tsconfig.json && tsc -p games/bubblepong/tsconfig.json && tsc -p games/Grillking/tsconfig.json && tsc -p games/SumoClash/tsconfig.json && tsc -p games/Homerun/tsconfig.json && tsc -p games/DragonBeat/tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.60.0",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-pwa": "0.21.1",
    "vitest": "2.1.8"
  },
  "dependencies": {
    "phaser": "3.90.0"
  }
}
